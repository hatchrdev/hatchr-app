{
  "name": "hatchr-desktop",
  "productName": "Hatchr",
  "version": "3.5.10",
  "description": "Hatchr desktop app: breaking posts to pump.fun memecoins",
  "main": "main.js",
  "desktopName": "hatchr-desktop.desktop",
  "author": "Hatchr",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "sync": "node sync.mjs",
    "start": "node sync.mjs && electron .",
    "dist:win": "node sync.mjs && electron-builder --win --x64",
    "dist:mac": "node sync.mjs && electron-builder --mac",
    "dist:linux": "node sync.mjs && electron-builder --linux",
    "test": "node --test tests/*.test.cjs app/tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "44.11.3",
    "electron-builder": "26.17.0",
    "electron-builder-squirrel-windows": "26.17.0"
  },
  "build": {
    "appId": "com.hatchr.desktop",
    "productName": "Hatchr",
    "copyright": "\u00a9 2026 Hatchr",
    "files": [
      "main.js",
      "chrome-api.js",
      "preload-app.js",
      "preload-site.js",
      "ui/**/*",
      "app/**/*",
      "package.json",
      "desktop-callouts.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "Hatchr-${os}.${ext}",
    "win": {
      "target": [
        {
          "target": "squirrel",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Hatchr-mac.${ext}",
      "title": "Hatchr",
      "background": "build/background.png",
      "iconSize": 96,
      "iconTextSize": 13,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 196
        },
        {
          "x": 400,
          "y": 196,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Finance",
      "maintainer": "Hatchr",
      "artifactName": "Hatchr-linux.${ext}"
    },
    "publish": null,
    "squirrelWindows": {
      "artifactName": "Hatchr-Setup.${ext}",
      "name": "hatchr",
      "loadingGif": "build/install.gif",
      "iconUrl": "https://hatchr.pro/icon.ico"
    }
  },
  "homepage": "https://hatchr.pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/sologgg/hatchr.git"
  }
}
